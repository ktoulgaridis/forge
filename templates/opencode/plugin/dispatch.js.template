/**
 * {{PLUGIN_NAME}} — `dispatch`, the orchestrator's thin launcher on opencode.
 *
 * Your session is the orchestrator; `dispatch` fans out ONE writer worker per call and
 * returns immediately:
 *   dispatch({ agent, ticket, repo?, model?, variant?, task_id?, command? })
 *
 * A worker is a ROOT session created at a `location` — a git worktree of `repo`, one per
 * (repo, ticket) — running the graph-agent you name (`agent`). Because workers are roots
 * (no parentID), the native session list IS the fleet view; this plugin ships no UI.
 *
 * Non-blocking + poll-free (ADR 0017). dispatch creates + prompts the worker and returns
 * its id AT ONCE. A DETACHED `session.wait` then blocks to the worker's idle, reads its
 * result, and posts a <run-closed> line back into the orchestrator with `resume: false` —
 * admitted WITHOUT scheduling a turn, so the notice queues and surfaces on the
 * orchestrator's NEXT turn. The orchestrator never blocks and never spins an autonomous
 * loop. Call dispatch several times in one turn to fan out concurrently.
 *
 * The ticket IS the envelope: the worker reads it from the tracker, so the orchestrator
 * never re-authors a prompt and its context stays lean. `command` carries only what the
 * tracker does not (e.g. the review deficiencies to address). Pass `task_id` to continue
 * the SAME worker (its worktree + agent were fixed at create); a resume re-prompts and
 * gets its own detached postback.
 *
 * Validating runs do NOT come through dispatch — they run through the native subagent tool
 * (`subagent_type: "validate"`), whose read-only boundary is the validating agent's own
 * frontmatter (`agent/validate.md`). Dispatch owns exactly the per-(repo, ticket) worktree
 * grant: the writer's location, which a native subagent child (pinned to the parent's
 * location) cannot give.
 *
 * Model policy (definition-time, fail-closed): a `model` must be on the org provider and
 * off the banned list. Unset = OMITTED, so the graph-agent's own default (the org floor)
 * applies — dispatch pins no hardcoded default of its own.
 *
 * Only DECLARED workers launch (ADR 0019 §4): WORKERS is rendered from the org's graph
 * catalog, each with its isolation — `worktree` (one git worktree per (repo, ticket)) or
 * `none` (runs in place at the workspace: no worktree, no repo). The orchestrator's own
 * agent and every host built-in are refused.
 *
 * Fails closed: an undeclared agent, neither ticket nor task_id, ambiguous/escaping repo,
 * banned or off-provider model, a variant with no model or on a 1.x host (it would be dropped), foreign
 * task_id → nothing is created and the reason is the tool output.
 *
 * ONE artifact, TWO hosts (back/forward compatible by construction):
 *   - opencode 2.x loads `setup(ctx)` — everything real arrives on `ctx`, so this file
 *     imports only node builtins at the top level. Postback = `session.prompt({resume:
 *     false})`; the detached waiter survives the tool's return because `ctx.session.*` is
 *     bound to the plugin's long-lived runtime, not the tool call's abort signal.
 *   - opencode 1.18.29+ loads `server()` — the 1.x SDK (`@opencode-ai/plugin`) is imported
 *     DYNAMICALLY inside `server()` so a 2.x host never resolves it. Postback =
 *     `session.promptAsync({noReply: true})`; the worker prompt is fired without awaiting.
 * Both hosts drive the SAME decision core (decide() + the worktree/registry logic), so the
 * model policy and the one-worktree-per-(repo, ticket) invariant cannot drift.
 */
import { execFile as execFileCb } from "node:child_process"
import { existsSync, mkdirSync, readFileSync, readdirSync, statSync, writeFileSync } from "node:fs"
import { basename, join, resolve, sep } from "node:path"
import { promisify } from "node:util"

const execFile = promisify(execFileCb)

const PROVIDER = "{{OC_PROVIDER_ID}}"
const BANNED = [{{OC_MODEL_BANNED_JSON}}]
// The declared workers and their isolation — rendered from the graph catalog.
const WORKERS = {{OC_WORKERS_JSON}}
const WORKTREES_DIR = ".worktrees"

// Worktree paths reserved by an in-flight dispatch in THIS process. A worker is only
// persisted (recordRun) AFTER session.create, so two same-turn dispatches for one
// (repo, ticket) both snapshot an EMPTY registry at loadRuns() and holderOf sees no
// holder for either. Without this reservation the first caller creates the tree and
// yields at its first await, and the second finds it on disk and takes the reuse path —
// two writers in one working tree. JS is single-threaded, so a claim taken with NO await
// between the check and the set is atomic per call; the reservation spans the whole
// session.create + recordRun window, after which the persisted registry guards the path.
const claimed = new Set()

// Workers this workspace issued: task_id → { agent, ticket, directory }. Only these ids
// may be resumed. Persisted next to the worktrees so a restart of opencode neither forgets
// a worker nor strands its ticket.
const REGISTRY = ".dispatch.json"
const registryPath = (workspace) => join(workspace, WORKTREES_DIR, REGISTRY)
function loadRuns(workspace) {
  try { return new Map(Object.entries(JSON.parse(readFileSync(registryPath(workspace), "utf8")))) } catch { return new Map() }
}
// Concurrent dispatches in one turn must not lose each other's entry: updates are
// serialized and re-read the file before writing.
let registryLock = Promise.resolve()
function recordRun(workspace, id, run) {
  registryLock = registryLock.then(() => {
    const runs = loadRuns(workspace)
    runs.set(id, run)
    mkdirSync(join(workspace, WORKTREES_DIR), { recursive: true })
    writeFileSync(registryPath(workspace), JSON.stringify(Object.fromEntries(runs), null, 2))
  })
  return registryLock
}
const holderOf = (runs, directory) => [...runs.entries()].find(([, t]) => t.directory === directory)?.[0]

const firstLine = (s) => String(s ?? "").split("\n").map((l) => l.trim()).find(Boolean) ?? ""
// A worker ends every run with one `RESULT: …` line (the org's result contract). The
// postback carries THAT line — the last one, if the worker wrote several — and falls back
// to the first line only when a worker wrote none (e.g. the host stopped it at its cap).
const resultOf = (s) => {
  const lines = String(s ?? "").split("\n").map((l) => l.trim())
  return [...lines].reverse().find((l) => l.startsWith("RESULT:")) ?? firstLine(s)
}
// 1.x returns the finished response ({data:{parts}}); 2.x returns the transcript as a
// message list. Both extractors pick the worker's LAST text line — the orchestrator gets
// result lines, not the transcript.
const lastTextOf = (res) => { const parts = res?.data?.parts ?? []; return [...parts].reverse().find((p) => p.type === "text" && p.text)?.text ?? "" }
// Live 2.x carries a message's parts under `msg.content`; 1.x shapes use `msg.parts`
// (or `msg.info.parts`). Read all three — reading only the 1.x keys extracts EMPTY on
// live 2.x.
const lastTextOfMessages = (messages) => {
  let last
  for (const msg of messages ?? []) {
    for (const part of msg?.content ?? msg?.parts ?? msg?.info?.parts ?? []) {
      if (part?.type === "text" && part.text) last = part.text
    }
  }
  return last
}

// The round trip's closing line: EVERY worker posts its close back to the orchestrator —
// on completion AND on error (an error close is exactly when the postback matters; a
// silent death leaves the orchestrator believing the worker lives). It carries the
// worker's agent/ticket, its terminal status, and its result line — the orchestrator
// consumes verdicts, never transcripts. Delivered with resume:false so it surfaces on the
// orchestrator's next turn without waking one now.
const closingMessage = (args, sessionID, status, result) => [
  `<run-closed>`,
  `<task_id>${sessionID}</task_id>`,
  `<agent>${args.agent}</agent>`,
  ...(args.ticket ? [`<ticket>${args.ticket}</ticket>`] : []),
  `<status>${status}</status>`,
  `<result>${resultOf(result) || "(no result lines)"}</result>`,
  `</run-closed>`,
].join("\n")

const git = async (cwd, ...args) => (await execFile("git", args, { cwd, encoding: "utf8" })).stdout.trim()
const isRepo = async (dir) => { try { await git(dir, "rev-parse", "--git-dir"); return true } catch { return false } }
const safe = (s) => String(s).replace(/[^A-Za-z0-9._-]+/g, "-").replace(/^-+|-+$/g, "")
const refuse = (why) => ({ title: "dispatch refused", output: why })
const failed = (what, err) => ({ title: `dispatch failed: ${what}`, output: errText(err) })
// Errors arrive differently per host (1.x returns {error} objects, 2.x throws) — meet both.
const errText = (e) => (typeof e === "string" ? e : e?.message ?? JSON.stringify(e))

function resolveModel(ref) {
  // Unset = OMIT the model → the graph-agent's own default (the org floor) applies. The
  // launcher never pins a hardcoded default; a bad EXPLICIT ref still fails closed.
  if (!ref) return { ok: true, model: null }
  const i = ref.indexOf("/")
  const providerID = i > 0 ? ref.slice(0, i) : ""
  const modelID = i > 0 ? ref.slice(i + 1) : ref
  if (providerID !== PROVIDER) return { ok: false, why: `model must be on ${PROVIDER} (got ${ref})` }
  const hit = BANNED.find((b) => modelID.toLowerCase().includes(String(b).toLowerCase()))
  if (hit) return { ok: false, why: `model ${modelID} is banned by policy (${hit})` }
  return { ok: true, model: { providerID, modelID } }
}

/** cwd is a repo → cwd; else the named DIRECT child repo; else the only child repo; else fail. */
async function resolveRepo(workspace, repo) {
  if (await isRepo(workspace)) return { ok: true, dir: workspace }
  if (repo) {
    if (repo !== basename(repo) || repo === "." || repo === "..") return refuse(`repo must be a direct child of the workspace (got '${repo}')`)
    const dir = resolve(workspace, repo)
    if (!dir.startsWith(workspace + sep)) return refuse(`repo '${repo}' is outside the workspace`)
    return (await isRepo(dir)) ? { ok: true, dir } : refuse(`repo '${repo}' is not a git repo under ${workspace}`)
  }
  const repos = []
  for (const n of readdirSync(workspace)) {
    if (n.startsWith(".") || !statSync(join(workspace, n)).isDirectory()) continue
    if (await isRepo(join(workspace, n))) repos.push(n)
  }
  if (repos.length === 1) return { ok: true, dir: join(workspace, repos[0]) }
  return refuse(`repo is required: the workspace has ${repos.length} repos (${repos.join(", ") || "none"})`)
}

/** One worktree per (repo, ticket). If a live worker holds it, refuse and name the task_id
 *  (continue that worker instead of putting two writers in one tree). If the tree exists
 *  with no holder (a previous worker finished, or crashed), reuse it. */
async function worktreeFor(workspace, repoDir, ticket, runs) {
  const branch = safe(ticket)
  const path = join(workspace, WORKTREES_DIR, `${basename(repoDir)}--${branch}`)
  const holder = holderOf(runs, path)
  if (holder) return refuse(`a worker already holds ${path}; continue it with task_id=${holder}`)
  // Reserve the path for this in-flight dispatch BEFORE deciding reuse-vs-create, so a
  // sibling that snapshotted the same empty registry can't slip through either branch
  // (both a genuinely-orphaned reuse and a fresh create need the same guard). No await
  // between has() and add() → this claim is atomic per call. The claim is HELD across both
  // success returns and released in the host execute() once the worker is persisted; it is
  // released here only on worktreeFor's own failure exits.
  if (claimed.has(path)) return refuse(`a dispatch is already creating ${path}; retry or continue it by task_id`)
  claimed.add(path)
  mkdirSync(join(workspace, WORKTREES_DIR), { recursive: true })
  if (existsSync(path)) return { ok: true, path, reused: true }
  try { mkdirSync(path) } catch { claimed.delete(path); return refuse(`a dispatch is already creating ${path}; retry or continue it by task_id`) }
  let exists = true
  try { await git(repoDir, "show-ref", "--verify", "--quiet", `refs/heads/${branch}`) } catch { exists = false }
  try {
    if (exists) await git(repoDir, "worktree", "add", "-f", path, branch)
    else await git(repoDir, "worktree", "add", "-f", "-b", branch, path)
  } catch (e) {
    claimed.delete(path)
    await removeWorktree(repoDir, path)
    return failed("git worktree add", e?.stderr || e?.message || e)
  }
  return { ok: true, path }
}

async function removeWorktree(repoDir, path) {
  try { await git(repoDir, "worktree", "remove", "--force", path) } catch { /* best effort */ }
  try { await execFile("rm", ["-rf", path]) } catch { /* best effort */ }
}

const commandText = (args) => [args.ticket ? `${args.agent}: act on ${args.ticket}.` : null, args.command].filter(Boolean).join(" ")

/** The decision core BOTH hosts run: the model policy, the task_id handle rules, and the
 *  per-(repo, ticket) worktree grant. Returns a refusal (title + output, no `kind`) or a
 *  decision ({kind: "resume"|"fresh", ...}). Only the SESSION calls differ between hosts —
 *  never the policy. */
async function decide(workspace, args) {
  const declared = Object.keys(WORKERS).join(", ")
  if (!args.agent) return refuse(`dispatch needs an agent — one of the declared workers: ${declared}`)
  const worker = Object.prototype.hasOwnProperty.call(WORKERS, args.agent) ? WORKERS[args.agent] : null
  if (!worker) return refuse(`dispatch launches only declared workers (${declared}); '${args.agent}' is not one`)
  const m = resolveModel(args.model)
  if (!m.ok) return refuse(m.why)
  // A variant is part of a model selection: with no explicit model there is nothing to
  // carry it, and the launcher pins no floor of its own (the floor lives in the user's
  // opencode config) — refuse rather than drop it silently.
  if (!m.model && args.variant) return refuse("variant needs an explicit model (provider/model) to ride on — pass model too, or drop variant")

  // RESUME: continue a worker this workspace issued (its worktree + agent fixed at create).
  if (args.task_id) {
    const runs = loadRuns(workspace)
    const run = runs.get(args.task_id)
    if (!run) return refuse(`unknown task_id '${args.task_id}': only workers this dispatch issued can be continued`)
    return { kind: "resume", m, sessionID: args.task_id, directory: run.directory }
  }

  // FRESH: the ticket is the envelope; the writer gets its own worktree per (repo, ticket).
  if (!args.ticket) return refuse("dispatch needs a ticket (the worker reads it from the tracker) or a task_id to continue a worker")
  // An in-place worker (isolation: none) runs at the workspace itself: no worktree, no repo.
  if (worker.isolation === "none") return { kind: "fresh", m, repoDir: null, fresh: false, directory: workspace, ticket: args.ticket }
  const runs = loadRuns(workspace)
  const r = await resolveRepo(workspace, args.repo)
  if (!r.ok) return r
  const w = await worktreeFor(workspace, r.dir, args.ticket, runs)
  if (!w.ok) return w
  return { kind: "fresh", m, repoDir: r.dir, fresh: !w.reused, directory: w.path, ticket: args.ticket }
}

const DESCRIPTION =
  `Launch one ${"{{ORG_NAME}}"} worker and return at once. Name a declared worker ` +
  `(\`agent\`: ${Object.keys(WORKERS).join(", ")}) and pass a \`ticket\` — the worker reads the ` +
  "whole envelope from the tracker, in a git worktree of `repo` (one per (repo, ticket)) " +
  "or in place for an isolation-none worker. It runs as a ROOT session (the native session " +
  "list is your fleet view). Non-blocking: you get the task_id immediately and the worker's " +
  "<run-closed> line — carrying its RESULT line — surfaces on your NEXT turn. Call it " +
  "several times in one turn to fan out concurrently; pass task_id to continue the same " +
  "worker. Refuses (creating nothing) an undeclared agent, a missing ticket and task_id, an " +
  "ambiguous or escaping repo, a banned or off-provider model, a variant with no model or " +
  "on a 1.x host, and " +
  'an unknown task_id. Validating runs go through the native subagent tool (subagent_type: ' +
  '"validate"), not dispatch.'
const ARG_HELP = {
  agent: `the declared worker to run: ${Object.keys(WORKERS).join(", ")}`,
  ticket: "tracker key the worker acts on; the worker reads the whole envelope from the tracker",
  repo: "repo dir under the workspace to worktree (needed when the workspace has several repos)",
  model: `provider/model on ${PROVIDER}; unset = the agent's own default (the org floor)`,
  variant: "model variant (effort) for this worker; needs an explicit model (opencode 2.x only)",
  task_id: "continue this earlier worker instead of launching a fresh one",
  command: "short instruction beyond 'act on the ticket' (e.g. the review deficiencies to address)",
}

export default {
  id: "{{PLUGIN_NAME}}-dispatch",

  /** opencode 2.x. The tool registers through a synchronous transform; the worker is a
   *  root session created at `location` (2.x has no parentID — workers are roots so the
   *  native session list is the fleet view). The prompt is admitted, then a DETACHED
   *  waiter blocks to idle, reads the result, and posts it back with resume:false. */
  async setup(ctx) {
    const workspace = ctx.location.directory
    // The 2.x runtime DIES on a tool result carrying `output` while the tool definition
    // declares no output schema (core/src/tool/runtime.ts:46). The native no-schema result
    // is `{content, metadata}`: the worker's text under `content` — the SAME text the 1.x
    // path carries in `output`, so the shared skills stay host-neutral — and the title
    // under `metadata.title`. Marshal at ONE boundary — the registration site — never in
    // the decision core, so the core keeps speaking the 1.x shape and cannot drift.
    const native = (run) => async (args, tool) => {
      const r = await run(args, tool)
      return { content: r.output, metadata: { title: r.title } }
    }
    await ctx.tool.transform((editor) => {
      editor.add({
        name: "dispatch",
        description: DESCRIPTION,
        input: {
          type: "object",
          properties: {
            agent: { type: "string", description: ARG_HELP.agent },
            ticket: { type: "string", description: ARG_HELP.ticket },
            repo: { type: "string", description: ARG_HELP.repo },
            model: { type: "string", description: ARG_HELP.model },
            variant: { type: "string", description: ARG_HELP.variant },
            task_id: { type: "string", description: ARG_HELP.task_id },
            command: { type: "string", description: ARG_HELP.command },
          },
          required: ["agent"],
          additionalProperties: false,
        },
        execute: native(async (args, tool) => {
          const d = await decide(workspace, args)
          if (!d.kind) return d

          // A fresh worker is created at its worktree location; a resume re-prompts the
          // worker its task_id names. Agent + model were fixed at create.
          let sessionID = d.sessionID
          const fresh = d.kind === "fresh"
          if (fresh) {
            let created
            try {
              created = await ctx.session.create({
                title: `${args.agent} ${args.ticket}`,
                agent: args.agent,
                ...(d.m.model
                  ? { model: { providerID: d.m.model.providerID, id: d.m.model.modelID, ...(args.variant ? { variant: args.variant } : {}) } }
                  : {}),
                location: { directory: d.directory },
                // Workers are ROOT sessions — no parentID, so the native session list is
                // the fleet view (ADR 0017). The ticket labels the run.
                metadata: { run: true, ticket: args.ticket },
              })
            } catch (e) { created = { error: e } }
            if (created.error || !created.id) {
              claimed.delete(d.directory)  // release the reservation; the tree (if fresh) is torn down below
              if (d.fresh) await removeWorktree(d.repoDir, d.directory)
              return failed("session.create", created.error ?? "no session id")
            }
            sessionID = created.id
            await recordRun(workspace, sessionID, { agent: args.agent, ticket: args.ticket, directory: d.directory })
            // Worker is persisted: the registry's holderOf now guards this path, so the
            // in-memory reservation is no longer needed. Release it only now — the claim
            // had to span the whole create + record await window.
            claimed.delete(d.directory)
          }

          // The closing postback: fired once, when the worker goes idle, on completion AND
          // on error. resume:false admits the line WITHOUT scheduling a turn — it surfaces
          // on the orchestrator's next turn (ADR 0017; poll-free, no autonomous loop).
          const parent = tool?.sessionID
          const postClose = parent
            ? async (status, result) => {
                try { await ctx.session.prompt({ sessionID: parent, text: closingMessage(args, sessionID, status, result), resume: false }) }
                catch { /* best-effort — the tracker is the durable record */ }
              }
            : async () => {}

          let promptErr
          try { await ctx.session.prompt({ sessionID, text: commandText(args) }) }
          catch (e) { promptErr = e }
          if (promptErr) { await postClose("error", errText(promptErr)); return failed("session.prompt", promptErr) }

          // Detach the waiter: block to the worker's idle, read the result, post it back.
          // Fire-and-forget async started inside a tool execute keeps running on the plugin
          // runtime (ctx.session.* is bound to it, not the tool's abort signal), so the
          // orchestrator gets the id NOW and never blocks.
          ;(async () => {
            let status = "complete", result
            try {
              await ctx.session.wait({ sessionID })
              result = lastTextOfMessages(await ctx.session.context({ sessionID }))
            } catch (e) { status = "error"; result = errText(e) }
            await postClose(status, result)
          })()
          return { title: `${args.agent} ${args.ticket ?? sessionID}`, output: `task_id=${sessionID} launched; its <run-closed> line will surface on your next turn` }
        }),
      })
    })
    return () => {}
  },

  /** opencode 1.18.29+. The 1.x SDK import is DYNAMIC on purpose: a 2.x host never calls
   *  server() and so never resolves `@opencode-ai/plugin` (which its loader cannot provide
   *  for local plugins). A 1.x host resolves it at runtime. */
  async server({ client }) {
    const { tool } = await import("@opencode-ai/plugin")

    /** Prompt the worker (fresh or resume) WITHOUT awaiting, then post <run-closed> back to
     *  the orchestrator on the worker's terminal transition (completion AND error). The
     *  orchestrator gets the task_id at once. `parent` is the orchestrator's session id. */
    const launch = async (sessionID, directory, args, m, parent, parentAgent) => {
      const body = { agent: args.agent, parts: [{ type: "text", text: commandText(args) }], ...(m.model ? { model: m.model } : {}) }
      const req = { path: { id: sessionID }, query: { directory }, body }
      const postback = (status, result) => parent
        ? client.session.promptAsync({
            path: { id: parent },
            body: { noReply: true, agent: parentAgent, parts: [{ type: "text", text: closingMessage(args, sessionID, status, result) }] },
          }).catch(() => { /* best-effort — the tracker is the durable record */ })
        : null
      // Fire-and-forget: return the id now; the <run-closed> postback fires on idle.
      client.session.prompt(req)
        .then((res) => postback(res.error ? "error" : "complete", res.error ? errText(res.error) : lastTextOf(res)))
        .catch((e) => postback("error", errText(e)))
      return { title: `${args.agent} ${args.ticket ?? sessionID}`, output: `task_id=${sessionID} launched; its <run-closed> line will surface on your next turn` }
    }

    return {
      tool: {
        dispatch: tool({
          description: DESCRIPTION,
          args: {
            agent: tool.schema.string().describe(ARG_HELP.agent),
            ticket: tool.schema.string().optional().describe(ARG_HELP.ticket),
            repo: tool.schema.string().optional().describe(ARG_HELP.repo),
            model: tool.schema.string().optional().describe(ARG_HELP.model),
            variant: tool.schema.string().optional().describe(ARG_HELP.variant),
            task_id: tool.schema.string().optional().describe(ARG_HELP.task_id),
            command: tool.schema.string().optional().describe(ARG_HELP.command),
          },
          async execute(args, ctx) {
            // 1.x's prompt body has no variant: refuse rather than drop it silently.
            if (args.variant) return refuse("variant is honored only on opencode 2.x — drop it, or set the effort on the org floor")
            const d = await decide(ctx.directory, args)
            if (!d.kind) return d
            // A resume re-prompts the worker its task_id names; it gets its own postback
            // (the worker starts a new turn the original launch's waiter won't catch).
            if (d.kind === "resume") return await launch(d.sessionID, d.directory, args, d.m, ctx.sessionID, ctx.agent)

            // FRESH: create the worker as a ROOT session (no parentID) at its worktree.
            // `query.directory` on EVERY call: the server resolves the project per request,
            // so without it the worker's tools would run in the orchestrator's directory.
            const created = await client.session.create({
              body: { title: `${args.agent} ${args.ticket}` },
              query: { directory: d.directory },
            })
            if (created.error || !created.data?.id) {
              claimed.delete(d.directory)  // release the reservation; the tree (if fresh) is torn down below
              if (d.fresh) await removeWorktree(d.repoDir, d.directory)
              return failed("session.create", created.error ?? "no session id")
            }
            const sessionID = created.data.id
            await recordRun(ctx.directory, sessionID, { agent: args.agent, ticket: args.ticket, directory: d.directory })
            // Worker is persisted: the registry's holderOf now guards this path, so the
            // in-memory reservation is no longer needed. Release it only now.
            claimed.delete(d.directory)
            return await launch(sessionID, d.directory, args, d.m, ctx.sessionID, ctx.agent)
          },
        }),
      },
    }
  },
}
