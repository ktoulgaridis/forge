{
  "$schema": "https://opencode.ai/config.json",
  "enabled_providers": ["{{OC_PROVIDER_ID}}"],
  "disabled_providers": [
{{#OC_DISABLED_PROVIDERS}}
    "{{name}}"{{comma}}
{{/OC_DISABLED_PROVIDERS}}
  ],
  "model": "{{OC_DEFAULT_MODEL_REF}}",
  "small_model": "{{OC_SMALL_MODEL_REF}}",
  "default_agent": "{{OC_PRIMARY_AGENT}}",
  "subagent_depth": 2,
  "instructions": [
    "AGENTS.md",
{{#OC_WIKI_INSTRUCTIONS}}
    "{{path}}"{{comma}}
{{/OC_WIKI_INSTRUCTIONS}}
  ],
  "permission": { "external_directory": "allow", "task": "deny" }
}
