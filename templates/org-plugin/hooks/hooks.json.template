{
  "description": "{{ORG_NAME}} harness hooks — advisory reminders (prime/handoff/wiki, non-blocking, fail-open) + worktree isolation (WorktreeCreate/Remove) when the session cwd is a repo or WORKTREE_REPO names one; from a multi-repo root the orchestrator passes the worktree in the envelope instead.{{#CODE_GATE_ENABLED}} Plus ONE blocking gate: a read-only worker's Bash runs only its declared read commands (PreToolUse, keyed on agent_type; every other agent passes through).{{/CODE_GATE_ENABLED}}",
  "hooks": {
{{#CODE_GATE_ENABLED}}
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/code-read-gate.sh\""
          }
        ]
      }
    ],
{{/CODE_GATE_ENABLED}}
    "WorktreeCreate": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/worktree-create.sh\""
          }
        ]
      }
    ],
    "WorktreeRemove": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/worktree-remove.sh\""
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/prime-reminder.sh\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/handoff-nudge.sh\""
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/wiki-reminder.sh\""
          }
        ]
      }
    ]
  }
}
